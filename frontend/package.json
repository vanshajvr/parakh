{
  "name": "parakh-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_FIXTURES=1 vite",
    "prebuild": "node scripts/fetch-sim-prices.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "PYTHONPATH=.. ../.venv/bin/python -c \"import json; from api.main import app; print(json.dumps(app.openapi()))\" > openapi.json && npx --yes openapi-typescript@7.13.0 openapi.json -o src/api/schema.ts && rm openapi.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.2.8",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "lightweight-charts": "5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
